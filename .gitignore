# Dataset — 5.2 GB of YawDD videos. Obtained separately, see README.md.
YawDD dataset/
*.avi
*.rar
*.rar.gz

# Virtual environment — recreate with: pip install -r requirements.txt
.venv/
venv/
env/

# Superseded Colab notebook export, kept locally for reference only
mod_yawn.py

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Trained models and the MediaPipe landmarker are committed, about 5 MB in
# total, so the demo runs straight after a clone with no retraining and no
# separate download. The pickles are tied to the scikit-learn version pinned
# in requirements.txt.
*.pkl
*.joblib
*.onnx
!models/*.pkl
!models/*.task

# Generated data — event feature CSVs and recorded webcam MAR traces.
# Regenerate with main.py; realtime.py --record-signal produces the traces.
outputs/

# Signed report — carries signatures and student ID, not for a public repo
Interim Report*.pdf
*_Signed.pdf

